# Backend config
PORT=4000

# Your Kakao app credentials (register your redirect URI in Kakao developers)
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret  # optional for some apps

# FRONTEND URL where the user will be redirected after Kakao auth
FRONTEND_BASE_URL=http://localhost:5173

# Optional: json-server URL used for user lookup / creation
USER_DB_URL=http://localhost:3001

# Development helper: enable a mock Kakao flow that doesn't call the real Kakao servers.
# When MOCK_KAKAO=true the server will redirect to the frontend with `?code=mock`
# and will lookup/create a test user with providerId=`MOCK_PROVIDER_ID` in the json-server.
# This is useful for local dev without registering redirect URIs or using HTTPS.
MOCK_KAKAO=true
MOCK_PROVIDER_ID=12345
